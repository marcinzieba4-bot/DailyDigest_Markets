  "concrete_findings_and_resolutions": [
    {
      "finding": "Initial normalizers hid dropped bracketed numbers and word-boundary changes.",
      "resolution": "Retain every literal, bracket, number and word boundary; collapse only layout whitespace with NFC. Exact first-use citation ordinals are preserved instead of globally deleting numeric brackets. Independently reproduced former failures now reject."
    },
    {
      "finding": "Initial PDF substring membership accepted reordered paragraphs and deleted repeated occurrences; title-only source search could pass incomplete ledgers.",
      "resolution": "Ordered non-reusable paragraph occurrences including labels must appear before a unique ledger boundary; ordered title/outlet/publication records must appear after it. HTML compares the exact ordered paragraph list, chip IDs/ordinals/URLs and full ledger metadata. Synthetic reordered, duplicated/deleted and ledger-loss cases reject."
    },
    {
      "finding": "Hidden-parent source paths and unconstrained collection paths were admitted.",
      "resolution": "All hidden components, traversal, noncanonical paths, symlinks, repositories and credential filenames reject; exact date/kind native and collection locations are required. Renderer and partial-collection validation occur before any source file read."
    },
    {
      "finding": "JSON evidence membership and ZIP self-inventory alone did not prove exact accepted input identity.",
      "resolution": "JSON evidence now equals exact own-feed records plus only the exact own-date availability augmentation. ZIP reviewer binds current source/market/freeze acceptance, every accepted date feed/card and every raw replay-inventory row; tampering negatives reject."
    },
    {
      "finding": "Monthly retail collection audit did not check dated intros, labels, citation metadata or its full ledger.",
      "resolution": "Dedicated monthly_retail_day compares each intro/title/label/paragraph and paragraph/global citation identity, URL and hover metadata against the exact own feed, plus ordered full source records. Six engineer negatives and independent Unicode/literal/hover/ledger cases pass."
    },
    {
      "finding": "Receipt roles and delivery claims needed distinct scopes.",
      "resolution": "Self static QA, this independent code review and actual final-artifact review use unique paths. Only actual full runtime final_review sets runtime_artifacts_reviewed true. Both local and unchanged shared retail require_review gates must pass and shared snapshot bytes match the original."
    }
  ],
